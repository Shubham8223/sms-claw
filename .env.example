# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-minimum-32-characters-long
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sms-claw

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM — set at least one ────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=anthropic          # anthropic | openai | google | nvidia
DEFAULT_LLM_MODEL=claude-sonnet-4-20250514

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# NVIDIA (NeMo / NIM)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── SMS — set the one you use ──────────────────────────────────────────────────
DEFAULT_SMS_PROVIDER=twilio             # twilio | africas_talking | vonage

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

AT_API_KEY=...
AT_USERNAME=sandbox
AT_SENDER_ID=SMS_CLAW

VONAGE_API_KEY=...
VONAGE_API_SECRET=...
VONAGE_FROM=SMS_CLAW

# ── Security ───────────────────────────────────────────────────────────────────
ALLOWED_PHONE_NUMBERS=+919876543210,+911234567890
OTP_EXPIRY_SECONDS=300
RATE_LIMIT_MESSAGES_PER_HOUR=20

# ── Tool: Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=you@gmail.com

# ── Tool: WhatsApp ────────────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...

# ── Tool: GitHub ───────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ── Tool: Web search ───────────────────────────────────────────────────────────
SEARCH_PROVIDER=tavily                  # tavily | serpapi
TAVILY_API_KEY=tvly-...
SERPAPI_API_KEY=...

# ── Tool: Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...